# Origin frontend, dipisahkan dengan koma. Tambahkan origin HTTPS saat deploy.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Batas permintaan analisis dan simulasi per menit untuk setiap klien. 0 menonaktifkan.
API_RATE_LIMIT_PER_MINUTE=60
# Port untuk Docker. Uvicorn lokal menggunakan 8000 kecuali opsi --port diberikan.
PORT=8000
# Untuk pengembangan penyimpanan P1.
# DATABASE_URL=
